{
    position = "top"
    height = 50

    center = [
        // Notifications overlay example
        {
            type = "custom"
            bar = [
                {
                    type = "overlay"
                    class = "notifications"
                    child = {
                        type = "button"
                        class = "button"
                        label = "󰍥"
                        on_click = "!swaync-client -t"
                    }
                    overlays = [
                        {
                            type = "label"
                            label = "<span size='small'>3</span>"
                            halign = "end"
                            valign = "start"
                            pass_through = true
                        }
                    ]
                }

                // Mic with recording indicator example
                {
                    type = "overlay"
                    child = {
                        type = "label"
                        label = "🎤 "
                    }
                    overlays = [
                        {
                            type = "label"
                            label = "●"
                            halign = "end"
                            valign = "start"
                            pass_through = true
                        }
                    ]
                }
            ]
        }
    ]

    end = [
        { type = "clock" }
    ]
}
